model Enrollment {
  id         String @id @default(uuid())
  studentId  String
  semesterId String

  semester          Semester           @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  student           Users              @relation(fields: [studentId], references: [id], onUpdate: Cascade)
  Enrolementcourses CourseEnrollment[]
  fees              Fee?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, semesterId])
  @@index([studentId])
  @@index([semesterId])
}
