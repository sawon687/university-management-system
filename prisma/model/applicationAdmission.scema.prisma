model AdmissionApplication {
  id        String   @id @default(uuid())
  userId    String   @unique
  programId String

  educationType EducationType @default(HSC)


  sscResult     Json     // { url: string, publicId: string }
  hscResult     Json?    // { url: string, publicId: string }
  diplomaResult Json?    // { url: string, publicId: string }

  status AdmissionStatus @default(PENDING)

  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?

  user    Users   @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments  Payment?

  @@unique([userId, programId])
  @@index([userId])
  @@index([programId])
  @@index([status])
}