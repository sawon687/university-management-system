model Fee {
  id           String @id @default(uuid())

  studentId    String
  semesterId   String
  enroleMentId String @unique

  feeType PaymentType

  totalCredit   Decimal
  perCreditRate Decimal

  // Original/full fee amount
  totalAmount Decimal

  // Total unpaid amount
  remainingAmount Decimal

  // 1st installment
  firstInstallmentAmount          Decimal
  firstInstallmentRemainingAmount Decimal
  firstInstallmentStatus           PaymentStatus @default(PENDING)

  // 2nd installment
  secondInstallmentAmount          Decimal
  secondInstallmentRemainingAmount Decimal
  secondInstallmentStatus           PaymentStatus @default(PENDING)

  // 3rd installment
  thirdInstallmentAmount          Decimal
  thirdInstallmentRemainingAmount Decimal
  thirdInstallmentStatus           PaymentStatus @default(PENDING)

  student Users @relation( fields: [studentId],  references: [id],onDelete: Cascade)

  semester Semester @relation( fields: [semesterId],references: [id],onDelete: Cascade)

  enroleMent Enrollment @relation(fields: [enroleMentId],references: [id],onDelete: Cascade)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([semesterId])
  @@unique([studentId, semesterId])
}