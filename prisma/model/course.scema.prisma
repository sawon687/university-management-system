model Course {
  id            String   @id @default(uuid())
  title         String
  code          String   @unique
  description   String
  credit        Float

  semesterNumber Int         // 1 = First, 2 = Second, 3 = Third

  departmentId  String
  department    Department @relation(fields: [departmentId],references: [id],onDelete: Cascade)

  programId     String
  program       Program @relation( fields: [programId],references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prerequisites    PrerequisiteCourse[] @relation("CoursePrerequisites")
  prerequisiteFor  PrerequisiteCourse[] @relation("PrerequisiteForCourses")
  courseEnrollment CourseEnrollment[]

  @@index([programId])
  @@index([departmentId])
  @@index([semesterNumber])
  @@index([programId, semesterNumber])
}