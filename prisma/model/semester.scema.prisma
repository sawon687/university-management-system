model Semester {
  id                String       @id @default(uuid())
  name              SemesterCode       
  year              Int          // 2026
  startDate         DateTime
  endDate           DateTime
  registrationOpen  Boolean      @default(false)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  fees              Fee[]
  enrollments       Enrollment[]
  CourseAssign       CourseAssignt[]
  exam                Exam[]
  gpaResult           GPAResult[]
  @@unique([name,year])
}