model Semester {
  id               String       @id @default(uuid())
  name             SemesterCode
  year             Int // 2026
  startDate        String
  endDate          String
  registrationOpen Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fees         Fee[]
  enrollments  Enrollment[]
  CourseAssign CourseAssignt[]
  exam         Exam[]
  gpaResult    GPAResult[]
  courseResult CourseMarks[]

  @@unique([name, year])
}
