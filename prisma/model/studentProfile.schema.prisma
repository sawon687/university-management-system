model StudentProfile {
  id            String        @id @default(uuid())
  phone         String
  dateOfBirth   String
  gender        String
  address       String
  profilePhoto  String?
  studentId     String        @unique
  user          Users         @relation("studentProfile", fields: [studentId], references: [id], onDelete: Cascade)
  departmentId  String
  department    Department    @relation(fields: [departmentId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("studentProfile")
}
