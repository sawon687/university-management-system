<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>UniSphere - Instructor Account</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f1f5f9;
      font-family: Arial, Helvetica, sans-serif;
      color: #0f172a;
    "
  >
    <!-- Main Wrapper -->
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="
        width: 100%;
        background-color: #f1f5f9;
        padding: 40px 16px;
      "
    >
      <tr>
        <td align="center">

          <!-- Email Card -->
          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              width: 100%;
              max-width: 600px;
              background-color: #ffffff;
              border: 1px solid #e2e8f0;
              border-radius: 18px;
              overflow: hidden;
              box-shadow: 0 10px 35px rgba(15, 23, 42, 0.06);
            "
          >

            <!-- ================= HEADER ================= -->
            <tr>
              <td
                align="center"
                style="
                  padding: 30px 24px 28px;
                  background-color: #fffaf5;
                  border-bottom: 1px solid #ffedd5;
                "
              >

                <!-- Brand -->
                <table
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin: 0 auto"
                >
                  <tr>

                    <!-- Logo -->
                    <td
                      style="
                        vertical-align: middle;
                        padding-right: 11px;
                      "
                    >
                      <div
                        style="
                          width: 44px;
                          height: 44px;
                          background-color: #f97316;
                          border-radius: 12px;
                          text-align: center;
                          line-height: 44px;
                          box-shadow: 0 5px 14px rgba(249, 115, 22, 0.20);
                        "
                      >
                        <span
                          style="
                            color: #ffffff;
                            font-size: 22px;
                            line-height: 44px;
                            font-family: Arial, Helvetica, sans-serif;
                          "
                        >
                          🎓
                        </span>
                      </div>
                    </td>

                    <!-- Brand Name -->
                    <td
                      style="
                        vertical-align: middle;
                        text-align: left;
                      "
                    >
                      <div
                        style="
                          color: #0f172a;
                          font-size: 24px;
                          line-height: 1;
                          font-weight: 700;
                          letter-spacing: -0.6px;
                        "
                      >
                        <span style="color: #f97316">U</span>niSphere
                      </div>

                      <div
                        style="
                          margin-top: 5px;
                          color: #94a3b8;
                          font-size: 10px;
                          line-height: 1;
                          font-weight: 600;
                          letter-spacing: 0.8px;
                        "
                      >
                        UNIVERSITY MANAGEMENT PLATFORM
                      </div>
                    </td>

                  </tr>
                </table>

              </td>
            </tr>


            <!-- ================= CONTENT ================= -->
            <tr>
              <td style="padding: 38px 40px 36px">

                <!-- Badge -->
                <div
                  style="
                    text-align: center;
                    margin-bottom: 16px;
                  "
                >
                  <span
                    style="
                      display: inline-block;
                      padding: 6px 12px;
                      background-color: #fff7ed;
                      border: 1px solid #fed7aa;
                      border-radius: 999px;
                      color: #ea580c;
                      font-size: 10px;
                      font-weight: 700;
                      letter-spacing: 0.9px;
                      text-transform: uppercase;
                    "
                  >
                    Instructor Account
                  </span>
                </div>


                <!-- Heading -->
                <h1
                  style="
                    margin: 0;
                    color: #0f172a;
                    font-size: 27px;
                    line-height: 1.3;
                    font-weight: 700;
                    text-align: center;
                    letter-spacing: -0.5px;
                  "
                >
                  Your instructor account is ready
                </h1>


                <!-- Greeting -->
                <p
                  style="
                    margin: 15px 0 0;
                    color: #475569;
                    font-size: 14px;
                    line-height: 1.7;
                    text-align: center;
                  "
                >
                  Hello
                  <strong style="color: #0f172a">
                    <%= name %>
                  </strong>
                </p>


                <!-- Description -->
                <p
                  style="
                    max-width: 460px;
                    margin: 9px auto 0;
                    color: #64748b;
                    font-size: 14px;
                    line-height: 1.8;
                    text-align: center;
                  "
                >
                  Your instructor account has been successfully created by
                  the university administration. Use the credentials below
                  to sign in to your
                  <strong style="color: #f97316">UniSphere</strong>
                  account.
                </p>


                <!-- ================= CREDENTIALS ================= -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin-top: 28px"
                >
                  <tr>
                    <td
                      style="
                        padding: 22px 20px;
                        background-color: #fffaf5;
                        border: 1px solid #fed7aa;
                        border-radius: 14px;
                      "
                    >

                      <!-- Credential Title -->
                      <p
                        style="
                          margin: 0 0 18px;
                          color: #9a3412;
                          font-size: 10px;
                          font-weight: 700;
                          text-transform: uppercase;
                          letter-spacing: 1.7px;
                          text-align: center;
                        "
                      >
                        Account Credentials
                      </p>


                      <!-- Email -->
                      <table
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="margin-bottom: 12px"
                      >
                        <tr>
                          <td
                            style="
                              padding: 12px 14px;
                              background-color: #ffffff;
                              border: 1px solid #fed7aa;
                              border-radius: 9px;
                            "
                          >
                            <div
                              style="
                                color: #94a3b8;
                                font-size: 10px;
                                font-weight: 700;
                                text-transform: uppercase;
                                letter-spacing: 0.8px;
                                margin-bottom: 5px;
                              "
                            >
                              Email
                            </div>

                            <div
                              style="
                                color: #0f172a;
                                font-size: 14px;
                                font-weight: 600;
                                word-break: break-all;
                              "
                            >
                              <%= email %>
                            </div>
                          </td>
                        </tr>
                      </table>


                      <!-- Teacher Code -->
                      <table
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="margin-bottom: 12px"
                      >
                        <tr>
                          <td
                            style="
                              padding: 12px 14px;
                              background-color: #ffffff;
                              border: 1px solid #fed7aa;
                              border-radius: 9px;
                            "
                          >
                            <div
                              style="
                                color: #94a3b8;
                                font-size: 10px;
                                font-weight: 700;
                                text-transform: uppercase;
                                letter-spacing: 0.8px;
                                margin-bottom: 5px;
                              "
                            >
                              Teacher Code
                            </div>

                            <div
                              style="
                                color: #0f172a;
                                font-size: 14px;
                                font-weight: 600;
                              "
                            >
                              <%= teacherCode %>
                            </div>
                          </td>
                        </tr>
                      </table>


                      <!-- Temporary Password -->
                      <table
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                      >
                        <tr>
                          <td
                            style="
                              padding: 12px 14px;
                              background-color: #ffffff;
                              border: 1px solid #fdba74;
                              border-radius: 9px;
                            "
                          >
                            <div
                              style="
                                color: #9a3412;
                                font-size: 10px;
                                font-weight: 700;
                                text-transform: uppercase;
                                letter-spacing: 0.8px;
                                margin-bottom: 7px;
                              "
                            >
                              Temporary Password
                            </div>

                            <div
                              style="
                                padding: 12px 14px;
                                background-color: #fff7ed;
                                border: 1px dashed #fb923c;
                                border-radius: 8px;
                                color: #c2410c;
                                font-family: 'Courier New', monospace;
                                font-size: 16px;
                                font-weight: 700;
                                letter-spacing: 1px;
                                word-break: break-all;
                              "
                            >
                              <%= password %>
                            </div>

                            <div
                              style="
                                margin-top: 8px;
                                color: #94a3b8;
                                font-size: 10px;
                                line-height: 1.5;
                              "
                            >
                              Select the password above and copy it manually.
                            </div>

                          </td>
                        </tr>
                      </table>

                    </td>
                  </tr>
                </table>


                <!-- ================= SECURITY ================= -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin-top: 18px"
                >
                  <tr>
                    <td
                      style="
                        padding: 16px 18px;
                        background-color: #fff7ed;
                        border: 1px solid #fed7aa;
                        border-radius: 10px;
                      "
                    >
                      <p
                        style="
                          margin: 0;
                          color: #9a3412;
                          font-size: 11px;
                          line-height: 1.7;
                          text-align: center;
                        "
                      >
                        <strong>🔒 Important:</strong>
                        This is a temporary password. Please log in and
                        change your password immediately after your first
                        login.
                        <br />
                        Never share your password with anyone.
                      </p>
                    </td>
                  </tr>
                </table>


                <!-- ================= LOGIN BUTTON ================= -->
                <table
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin: 26px auto 0"
                >
                  <tr>
                    <td
                      align="center"
                      style="
                        background-color: #f97316;
                        border-radius: 9px;
                      "
                    >
                      <a
                        href="<%= loginUrl %>"
                        style="
                          display: inline-block;
                          padding: 13px 25px;
                          color: #ffffff;
                          text-decoration: none;
                          font-size: 13px;
                          font-weight: 700;
                          letter-spacing: 0.1px;
                        "
                      >
                        Login to UniSphere
                      </a>
                    </td>
                  </tr>
                </table>


                <!-- Help -->
                <p
                  style="
                    max-width: 460px;
                    margin: 18px auto 0;
                    color: #94a3b8;
                    font-size: 11px;
                    line-height: 1.7;
                    text-align: center;
                  "
                >
                  If you did not expect this account, please contact the
                  university administration.
                </p>

              </td>
            </tr>


            <!-- ================= FOOTER ================= -->
            <tr>
              <td
                align="center"
                style="
                  padding: 23px 25px;
                  background-color: #f8fafc;
                  border-top: 1px solid #e2e8f0;
                "
              >

                <!-- Footer Brand -->
                <div
                  style="
                    color: #334155;
                    font-size: 14px;
                    font-weight: 700;
                    letter-spacing: -0.2px;
                  "
                >
                  <span style="color: #f97316">U</span>niSphere
                </div>


                <p
                  style="
                    margin: 6px 0 0;
                    color: #94a3b8;
                    font-size: 10px;
                  "
                >
                  Your University. Your Future.
                </p>


                <p
                  style="
                    margin: 11px 0 0;
                    color: #cbd5e1;
                    font-size: 10px;
                  "
                >
                  © <%= new Date().getFullYear() %> UniSphere.
                  All rights reserved.
                </p>

              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>