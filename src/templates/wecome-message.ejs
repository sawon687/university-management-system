<!DOCTYPE html>

<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome to UniSphere</title>
</head>

<body style="
  margin: 0;
  padding: 0;
  background-color: #f1f5f9;
  font-family: Arial, Helvetica, sans-serif;
">

  <table width="100%" cellpadding="0" cellspacing="0" border="0"
    style="background-color: #f1f5f9; padding: 40px 15px;">


<tr>
  <td align="center">

    <table width="600" cellpadding="0" cellspacing="0" border="0"
      style="
        max-width: 600px;
        width: 100%;
        background-color: #ffffff;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(15, 23, 42, 0.08);
      ">

      <!-- Header -->
      <tr>
        <td align="center"
          style="
            background-color: #2563eb;
            padding: 40px 25px;
          ">

          <!-- Logo -->
          <div style="
            width: 70px;
            height: 70px;
            margin: 0 auto 16px auto;
            background-color: #ffffff;
            border-radius: 50%;
            line-height: 70px;
            font-size: 32px;
            font-weight: bold;
            color: #2563eb;
            border: 4px solid rgba(255,255,255,0.30);
          ">
            U
          </div>

          <h1 style="
            margin: 0;
            color: #ffffff;
            font-size: 28px;
          ">
            UniSphere
          </h1>

          <p style="
            margin: 8px 0 0 0;
            color: #dbeafe;
            font-size: 14px;
          ">
            Your University. Your Future.
          </p>

        </td>
      </tr>


      <!-- Content -->
      <tr>
        <td style="padding: 42px 40px 35px 40px;">

          <!-- Success Icon -->
          <div style="
            width: 65px;
            height: 65px;
            margin: 0 auto 20px auto;
            background-color: #dcfce7;
            border-radius: 50%;
            text-align: center;
            line-height: 65px;
            font-size: 30px;
          ">
            ✓
          </div>

          <h2 style="
            margin: 0 0 15px 0;
            color: #0f172a;
            font-size: 25px;
            text-align: center;
          ">
            Account Created Successfully!
          </h2>

          <p style="
            margin: 0 0 16px 0;
            color: #475569;
            font-size: 16px;
            line-height: 1.7;
            text-align: center;
          ">
            Welcome to
            <strong style="color: #2563eb;">
              UniSphere
            </strong>,
            <strong style="color: #0f172a;">
              <%= name %>
            </strong>!
          </p>

          <p style="
            margin: 0;
            color: #64748b;
            font-size: 15px;
            line-height: 1.8;
            text-align: center;
          ">
            Your student account has been successfully created.
            You can now access your UniSphere account and explore
            your university's academic services.
          </p>


          <!-- Welcome Card -->
          <div style="
            margin: 30px 0;
            padding: 25px;
            background-color: #eff6ff;
            border: 1px solid #dbeafe;
            border-radius: 14px;
            text-align: center;
          ">

            <h3 style="
              margin: 0 0 12px 0;
              color: #1e3a8a;
              font-size: 18px;
            ">
              🎓 Welcome to Your Academic Journey
            </h3>

            <p style="
              margin: 0;
              color: #64748b;
              font-size: 14px;
              line-height: 1.7;
            ">
              UniSphere is here to help you manage your
              academic life with ease.
            </p>

          </div>


          <!-- Features -->
          <table width="100%" cellpadding="0" cellspacing="0" border="0">

            <tr>
              <td style="
                padding: 10px;
                color: #475569;
                font-size: 14px;
              ">
                📚 &nbsp; Manage your courses
              </td>
            </tr>

            <tr>
              <td style="
                padding: 10px;
                color: #475569;
                font-size: 14px;
              ">
                📝 &nbsp; Track your academic results
              </td>
            </tr>

            <tr>
              <td style="
                padding: 10px;
                color: #475569;
                font-size: 14px;
              ">
                📅 &nbsp; View your class schedule
              </td>
            </tr>

            <tr>
              <td style="
                padding: 10px;
                color: #475569;
                font-size: 14px;
              ">
                🎓 &nbsp; Manage your student profile
              </td>
            </tr>

          </table>


          <!-- Message -->
          <p style="
            margin: 25px 0 0 0;
            color: #64748b;
            font-size: 14px;
            line-height: 1.7;
            text-align: center;
          ">
            We are excited to have you with us.
            Wishing you a successful and rewarding academic journey!
          </p>

        </td>
      </tr>


      <!-- Footer -->
      <tr>
        <td style="
          background-color: #f8fafc;
          padding: 28px 25px;
          border-top: 1px solid #e2e8f0;
          text-align: center;
        ">

          <div style="
            width: 38px;
            height: 38px;
            margin: 0 auto 10px auto;
            background-color: #2563eb;
            border-radius: 50%;
            line-height: 38px;
            color: #ffffff;
            font-size: 17px;
            font-weight: bold;
          ">
            U
          </div>

          <p style="
            margin: 0;
            color: #334155;
            font-size: 14px;
            font-weight: 700;
          ">
            UniSphere
          </p>

          <p style="
            margin: 6px 0 0 0;
            color: #94a3b8;
            font-size: 12px;
          ">
            University Management Platform
          </p>

          <p style="
            margin: 10px 0 0 0;
            color: #94a3b8;
            font-size: 11px;
          ">
            © <%= new Date().getFullYear() %> UniSphere.
            All rights reserved.
          </p>

        </td>
      </tr>

    </table>

  </td>
</tr>


  </table>

</body>

</html>
