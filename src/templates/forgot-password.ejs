<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UniSphere - Forgot Password Verification Code</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f1f5f9;
      font-family: Arial, Helvetica, sans-serif;
      color: #0f172a;
    "
  >
    <!-- Main Wrapper -->
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="
        width: 100%;
        background-color: #f1f5f9;
        padding: 40px 16px;
      "
    >
      <tr>
        <td align="center">

          <!-- Email Card -->
          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              width: 100%;
              max-width: 600px;
              background-color: #ffffff;
              border: 1px solid #e2e8f0;
              border-radius: 18px;
              overflow: hidden;
              box-shadow: 0 10px 35px rgba(15, 23, 42, 0.06);
            "
          >

            <!-- ================= HEADER ================= -->
            <tr>
              <td
                align="center"
                style="
                  padding: 30px 24px 28px;
                  background-color: #fffaf5;
                  border-bottom: 1px solid #ffedd5;
                "
              >

                <!-- Brand -->
                <table
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin: 0 auto"
                >
                  <tr>

                    <!-- Logo -->
                    <td
                      style="
                        vertical-align: middle;
                        padding-right: 11px;
                      "
                    >
                      <div
                        style="
                          width: 44px;
                          height: 44px;
                          background-color: #f97316;
                          border-radius: 12px;
                          text-align: center;
                          line-height: 44px;
                          box-shadow: 0 5px 14px rgba(249, 115, 22, 0.2);
                        "
                      >
                        <span
                          style="
                            color: #ffffff;
                            font-size: 22px;
                            line-height: 44px;
                            font-family: Arial, Helvetica, sans-serif;
                          "
                        >
                          🎓
                        </span>
                      </div>
                    </td>

                    <!-- Brand Name -->
                    <td
                      style="
                        vertical-align: middle;
                        text-align: left;
                      "
                    >
                      <div
                        style="
                          color: #0f172a;
                          font-size: 24px;
                          line-height: 1;
                          font-weight: 700;
                          letter-spacing: -0.6px;
                        "
                      >
                        <span style="color: #f97316">U</span>nSphere
                      </div>

                      <div
                        style="
                          margin-top: 5px;
                          color: #94a3b8;
                          font-size: 10px;
                          line-height: 1;
                          font-weight: 600;
                          letter-spacing: 0.8px;
                        "
                      >
                        UNIVERSITY MANAGEMENT PLATFORM
                      </div>
                    </td>

                  </tr>
                </table>

              </td>
            </tr>

            <!-- ================= CONTENT ================= -->
            <tr>
              <td style="padding: 38px 40px 36px">

                <!-- Badge -->
                <div
                  style="
                    text-align: center;
                    margin-bottom: 16px;
                  "
                >
                  <span
                    style="
                      display: inline-block;
                      padding: 6px 12px;
                      background-color: #fff7ed;
                      border: 1px solid #fed7aa;
                      border-radius: 999px;
                      color: #ea580c;
                      font-size: 10px;
                      font-weight: 700;
                      letter-spacing: 0.9px;
                      text-transform: uppercase;
                    "
                  >
                    Password Reset
                  </span>
                </div>

                <!-- Heading -->
                <h1
                  style="
                    margin: 0;
                    color: #0f172a;
                    font-size: 27px;
                    line-height: 1.3;
                    font-weight: 700;
                    text-align: center;
                    letter-spacing: -0.5px;
                  "
                >
                  Reset your password
                </h1>

                <!-- Greeting -->
                <p
                  style="
                    margin: 15px 0 0;
                    color: #475569;
                    font-size: 14px;
                    line-height: 1.7;
                    text-align: center;
                  "
                >
                  Hello
                  <strong style="color: #0f172a">
                    <%= name %>
                  </strong>
                </p>

                <!-- Description -->
                <p
                  style="
                    max-width: 460px;
                    margin: 9px auto 0;
                    color: #64748b;
                    font-size: 14px;
                    line-height: 1.8;
                    text-align: center;
                  "
                >
                  We received a request to reset your
                  <strong style="color: #f97316">UniSphere</strong>
                  account password. Use the verification code below to
                  continue.
                </p>

                <!-- ================= OTP CARD ================= -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin-top: 28px"
                >
                  <tr>
                    <td
                      align="center"
                      style="
                        padding: 25px 20px 23px;
                        background-color: #fffaf5;
                        border: 1px solid #fed7aa;
                        border-radius: 14px;
                      "
                    >

                      <!-- Label -->
                      <p
                        style="
                          margin: 0 0 13px;
                          color: #9a3412;
                          font-size: 10px;
                          font-weight: 700;
                          text-transform: uppercase;
                          letter-spacing: 1.7px;
                        "
                      >
                        Password Reset Code
                      </p>

                      <!-- OTP -->
                      <div
                        style="
                          display: inline-block;
                          padding: 14px 23px;
                          background-color: #ffffff;
                          border: 1px solid #fdba74;
                          border-radius: 11px;
                          box-shadow: 0 3px 12px rgba(249, 115, 22, 0.08);
                        "
                      >
                        <span
                          style="
                            color: #ea580c;
                            font-size: 29px;
                            font-weight: 700;
                            line-height: 1;
                            letter-spacing: 7px;
                          "
                        >
                          <%= otp %>
                        </span>
                      </div>

                      <!-- Hint -->
                      <p
                        style="
                          margin: 13px 0 0;
                          color: #94a3b8;
                          font-size: 11px;
                          line-height: 1.5;
                        "
                      >
                        Enter this code to continue resetting your password
                      </p>

                    </td>
                  </tr>
                </table>

                <!-- ================= EXPIRATION ================= -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin-top: 16px"
                >
                  <tr>
                    <td
                      align="center"
                      style="
                        padding: 12px 15px;
                        background-color: #fffbeb;
                        border: 1px solid #fde68a;
                        border-radius: 9px;
                      "
                    >
                      <p
                        style="
                          margin: 0;
                          color: #92400e;
                          font-size: 11px;
                          line-height: 1.6;
                        "
                      >
                        <strong>
                          ⏱ This code expires in
                          <%= expirtionSeconds %> minutes
                        </strong>
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- ================= SECURITY ================= -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin-top: 18px"
                >
                  <tr>
                    <td
                      style="
                        padding: 16px 18px;
                        background-color: #f8fafc;
                        border: 1px solid #e2e8f0;
                        border-radius: 10px;
                      "
                    >
                      <p
                        style="
                          margin: 0;
                          color: #64748b;
                          font-size: 11px;
                          line-height: 1.7;
                          text-align: center;
                        "
                      >
                        🔒 If you didn't request a password reset, you can
                        safely ignore this email.
                        <br />
                        Never share this verification code with anyone.
                      </p>
                    </td>
                  </tr>
                </table>

              </td>
            </tr>

            <!-- ================= FOOTER ================= -->
            <tr>
              <td
                align="center"
                style="
                  padding: 23px 25px;
                  background-color: #f8fafc;
                  border-top: 1px solid #e2e8f0;
                "
              >

                <!-- Footer Brand -->
                <div
                  style="
                    color: #334155;
                    font-size: 14px;
                    font-weight: 700;
                    letter-spacing: -0.2px;
                  "
                >
                  <span style="color: #f97316">U</span>nSphere
                </div>

                <p
                  style="
                    margin: 6px 0 0;
                    color: #94a3b8;
                    font-size: 10px;
                  "
                >
                  Your University. Your Future.
                </p>

                <p
                  style="
                    margin: 11px 0 0;
                    color: #cbd5e1;
                    font-size: 10px;
                  "
                >
                  © <%= new Date().getFullYear() %> UniSphere. All rights
                  reserved.
                </p>

              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>